{
  "productName": "WorshipFlow Pro",
  "version": "0.1.0",
  "identifier": "com.worshipflow.pro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "resizable": true,
        "title": "WorshipFlow Pro",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600
      },
      {
        "label": "output",
        "url": "output.html",
        "title": "Presentation Output",
        "visible": false,
        "fullscreen": false,
        "decorations": false,
        "width": 1280,
        "height": 720,
        "resizable": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "resources": [
      "src-tauri/resources/kjv_bible.json",
      "src-tauri/resources/ylt_bible.json",
      "src-tauri/resources/web_bible.json",
      "src-tauri/resources/asv_bible.json",
      "src-tauri/resources/bbe_bible.json",
      "src-tauri/resources/rsv_bible.json",
      "src-tauri/resources/twi_akuapem_bible.json",
      "src-tauri/resources/twi_asante_bible.json"
    ]
  }
}
