{
  "identifier": "default",
  "description": "Default capabilities for WorshipFlow Pro",
  "windows": ["*"],
  "permissions": [
    "core:default",
    {
      "identifier": "core:asset:default",
      "allow": [
        { "path": "**" },
        { "path": "$CACHE/**" },
        { "path": "$APPDATA/**" },
        { "path": "$HOME/**" },
        { "path": "/**" }
      ]
    },
    "event:default",
    "dialog:default",
    "dialog:allow-open"
  ]
}
