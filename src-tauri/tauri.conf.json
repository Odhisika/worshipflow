{
  "productName": "WorshipFlow Pro",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "identifier": "com.worshipflow.pro",
    "resources": [
      "resources/kjv_bible.json"
    ]
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "resizable": true,
        "title": "WorshipFlow Pro",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600
      },
      {
        "label": "output",
        "url": "output.html",
        "title": "Presentation Output",
        "visible": false,
        "fullscreen": false,
        "decorations": false,
        "width": 1280,
        "height": 720,
        "resizable": true,
        "skipTaskbar": true
      }
    ]
  }
}
